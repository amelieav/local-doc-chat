# Settings the backend reads from its environment. Set them in your shell; the app does not load .env yet.
# Never commit secrets.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Output size of OLLAMA_EMBED_MODEL (768 for nomic-embed-text). A different model needs a new DATA_DIR.
EMBED_DIMENSIONS=768
DATA_DIR=data

# Optional LangSmith tracing (off by default)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
